{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated institution administrator or examination coordinator profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["coordinator"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "institutionId", "role", "createdAt", "updatedAt"]
    },
    "Institution": {
      "title": "Institution",
      "description": "Private educational institution tenant profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "type": { "type": "string", "enum": ["School", "College", "University", "Coaching Institute", "Examination Center", "Other"] },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 },
        "city": { "type": "string", "minLength": 1, "maxLength": 100 },
        "state": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pinCode": { "type": "string", "minLength": 1, "maxLength": 20 },
        "mobile": { "type": "string", "minLength": 1, "maxLength": 30 },
        "logoDataUrl": { "type": "string", "maxLength": 300000 },
        "activeSubscriptionId": { "type": "string", "maxLength": 128 },
        "pendingPaymentRequestId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "type", "address", "city", "state", "pinCode", "mobile", "createdAt", "updatedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Examination record belonging to an institution.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "examType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "academicYear": { "type": "string", "minLength": 1, "maxLength": 40 },
        "examDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "examTime": { "type": "string", "maxLength": 40 },
        "subject": { "type": "string", "maxLength": 160 },
        "classCourse": { "type": "string", "maxLength": 120 },
        "semester": { "type": "string", "maxLength": 60 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["draft", "generated", "verified", "archived"] },
        "studentCount": { "type": "integer" },
        "classroomCount": { "type": "integer" },
        "totalBenches": { "type": "integer" },
        "totalCapacity": { "type": "integer" },
        "seatingMode": { "type": "integer" },
        "strategy": { "type": "string", "enum": ["sequential", "alternate", "section_separation", "custom"] },
        "sortOrder": { "type": "string", "enum": ["original", "ascending", "custom"] },
        "rollRangeStart": { "type": "string", "maxLength": 64 },
        "rollRangeEnd": { "type": "string", "maxLength": 64 },
        "latestPlanId": { "type": "string", "maxLength": 128 },
        "latestAuditStatus": { "type": "string", "enum": ["VERIFIED", "FAILED", "PENDING"] },
        "subscriptionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "ownerId", "name", "examType", "academicYear", "examDate", "status", "studentCount", "classroomCount", "totalBenches", "totalCapacity", "seatingMode", "strategy", "sortOrder", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record enrolled in an examination with immutable roll number formatting.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rollNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "maxLength": 160 },
        "className": { "type": "string", "maxLength": 80 },
        "course": { "type": "string", "maxLength": 120 },
        "section": { "type": "string", "maxLength": 40 },
        "subject": { "type": "string", "maxLength": 120 },
        "originalIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "rollNumber", "originalIndex", "createdAt"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Classroom configuration with rows, benches, and disabled bench markers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 60 },
        "building": { "type": "string", "maxLength": 100 },
        "floor": { "type": "string", "maxLength": 40 },
        "rows": { "type": "integer" },
        "benchesPerRow": { "type": "integer" },
        "rowBenchCounts": { "type": "array" },
        "disabledBenches": { "type": "array" },
        "disabled": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "roomNumber", "rows", "benchesPerRow", "disabled", "orderIndex", "createdAt"]
    },
    "SeatingPlan": {
      "title": "SeatingPlan",
      "description": "Versioned deterministic seating plan summary and audit metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "version": { "type": "integer" },
        "seatingMode": { "type": "integer" },
        "strategy": { "type": "string", "enum": ["sequential", "alternate", "section_separation", "custom"] },
        "sortOrder": { "type": "string", "enum": ["original", "ascending", "custom"] },
        "totalStudents": { "type": "integer" },
        "allocatedStudents": { "type": "integer" },
        "unallocatedStudents": { "type": "integer" },
        "totalBenches": { "type": "integer" },
        "totalCapacity": { "type": "integer" },
        "unusedSeats": { "type": "integer" },
        "auditStatus": { "type": "string", "enum": ["VERIFIED", "FAILED"] },
        "auditReport": { "type": "object" },
        "aiSummary": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "examId", "institutionId", "ownerId", "version", "seatingMode", "strategy", "sortOrder", "totalStudents", "allocatedStudents", "unallocatedStudents", "totalBenches", "totalCapacity", "unusedSeats", "auditStatus", "auditReport", "createdAt"]
    },
    "RoomAllocation": {
      "title": "RoomAllocation",
      "description": "Per-classroom seating allocation grid belonging to a specific seating plan version.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classroomId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classroomName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 60 },
        "building": { "type": "string", "maxLength": 100 },
        "floor": { "type": "string", "maxLength": 40 },
        "orderIndex": { "type": "integer" },
        "totalBenches": { "type": "integer" },
        "activeBenches": { "type": "integer" },
        "capacity": { "type": "integer" },
        "allocatedCount": { "type": "integer" },
        "unusedSeats": { "type": "integer" },
        "rows": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "classroomId", "classroomName", "roomNumber", "orderIndex", "totalBenches", "activeBenches", "capacity", "allocatedCount", "unusedSeats", "rows", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable institution activity and seating audit log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 100 },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "action", "entityType", "entityId", "summary", "createdAt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Manual UPI subscription payment verification request submitted by an institution coordinator.",
      "type": "object",
      "properties": {
        "paymentRequestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "amount": { "type": "integer" },
        "upiId": { "type": "string", "minLength": 5, "maxLength": 120 },
        "transactionReferenceId": { "type": "string", "maxLength": 120 },
        "screenshotStoragePath": { "type": "string", "minLength": 10, "maxLength": 500 },
        "screenshotFileName": { "type": "string", "maxLength": 200 },
        "screenshotMimeType": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string", "maxLength": 160 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "subscriptionId": { "type": "string", "maxLength": 128 }
      },
      "required": ["paymentRequestId", "institutionId", "institutionName", "userId", "userEmail", "amount", "upiId", "screenshotStoragePath", "status", "submittedAt"]
    },
    "PaymentProofFile": {
      "title": "PaymentProofFile",
      "description": "Private payment proof file metadata stored in Firestore when Firebase Storage is unavailable on Starter Tier.",
      "type": "object",
      "properties": {
        "paymentRequestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mimeType": { "type": "string", "enum": ["image/jpeg", "image/jpg", "image/png", "application/pdf"] },
        "byteSize": { "type": "integer" },
        "chunkCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentRequestId", "institutionId", "userId", "fileName", "mimeType", "byteSize", "chunkCount", "createdAt"]
    },
    "PaymentProofChunk": {
      "title": "PaymentProofChunk",
      "description": "Base64-encoded chunk of a payment proof screenshot or PDF stored privately under PaymentProofFile.",
      "type": "object",
      "properties": {
        "index": { "type": "integer" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "data": { "type": "string", "minLength": 1, "maxLength": 600000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["index", "ownerId", "institutionId", "data", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "15-day subscription record unlocked by manual admin approval and bound to one examination type upon first creation.",
      "type": "object",
      "properties": {
        "subscriptionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "paymentRequestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "integer" },
        "paymentStatus": { "type": "string", "enum": ["approved", "revoked"] },
        "approvalStatus": { "type": "string", "enum": ["approved", "expired", "revoked"] },
        "activatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "examinationTypeLocked": { "type": "boolean" },
        "lockedExaminationType": { "type": "string", "maxLength": 80 },
        "firstExaminationCreatedAt": { "type": "string", "format": "date-time" },
        "firstExamId": { "type": "string", "maxLength": 128 },
        "approvedBy": { "type": "string", "minLength": 3, "maxLength": 160 },
        "revokedAt": { "type": "string", "format": "date-time" },
        "revokedBy": { "type": "string", "maxLength": 160 },
        "revocationReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subscriptionId", "institutionId", "institutionName", "ownerId", "userEmail", "paymentRequestId", "planName", "amount", "paymentStatus", "approvalStatus", "activatedAt", "expiresAt", "examinationTypeLocked", "approvedBy", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification sent to an institution when a payment is approved, rejected, or subscription revoked.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["payment_approved", "payment_rejected", "subscription_revoked", "subscription_expired"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 600 },
        "read": { "type": "boolean" },
        "relatedId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "institutionId", "ownerId", "type", "title", "message", "read", "relatedId", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin action audit log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "action": { "type": "string", "enum": ["PAYMENT_APPROVED", "PAYMENT_REJECTED", "SUBSCRIPTION_REVOKED"] },
        "targetType": { "type": "string", "enum": ["paymentRequest", "subscription"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "institutionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminUid", "adminEmail", "action", "targetType", "targetId", "institutionId", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile linking an authenticated user to their institution."
    },
    "/institutions/{institutionId}": {
      "schema": { "$ref": "#/entities/Institution" },
      "description": "Institution root document owned by a single authenticated coordinator."
    },
    "/institutions/{institutionId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Examinations created by the institution."
    },
    "/institutions/{institutionId}/exams/{examId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students enrolled in an examination."
    },
    "/institutions/{institutionId}/exams/{examId}/classrooms/{classroomId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Classroom layouts configured for an examination."
    },
    "/institutions/{institutionId}/exams/{examId}/seatingPlans/{planId}": {
      "schema": { "$ref": "#/entities/SeatingPlan" },
      "description": "Versioned seating plan summaries and audit reports."
    },
    "/institutions/{institutionId}/exams/{examId}/seatingPlans/{planId}/roomAllocations/{roomId}": {
      "schema": { "$ref": "#/entities/RoomAllocation" },
      "description": "Per-classroom seating allocations for a seating plan version."
    },
    "/institutions/{institutionId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable institution audit logs."
    },
    "/institutions/{institutionId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications for subscription approvals, rejections, and revocations."
    },
    "/paymentRequests/{paymentRequestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Manual UPI payment verification requests awaiting or reviewed by admin."
    },
    "/paymentProofFiles/{paymentRequestId}": {
      "schema": { "$ref": "#/entities/PaymentProofFile" },
      "description": "Private payment proof file metadata when stored in Firestore."
    },
    "/paymentProofFiles/{paymentRequestId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/PaymentProofChunk" },
      "description": "Ordered private base64 chunks of a payment proof file."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "15-day subscription records with immutable first-used examination type lock."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable audit log of every administrative approval, rejection, and revocation."
    }
  }
}
