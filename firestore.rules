rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    // Trusted Admin Authorization:
    // Requires agarwalpiyush263@gmail.com
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'agarwalpiyush263@gmail.com') ||
        request.auth.token.email == 'agarwalpiyush263@gmail.com'
      );
    }

    function isInstitutionOwner(institutionId) {
      return isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/institutions/$(institutionId)).data.ownerId == request.auth.uid
      );
    }

    function isInstitutionOwnerOrMember(institutionId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/institutions/$(institutionId)) &&
         get(/databases/$(database)/documents/institutions/$(institutionId)).data.ownerId == request.auth.uid) ||
        exists(/databases/$(database)/documents/institution_members/$(institutionId + '_' + request.auth.uid))
      );
    }

    // Coordinator Profiles:
    // Users can only create/update their own profile. Role escalation beyond 'coordinator' is forbidden.
    match /profiles/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'coordinator';
      allow update: if (
        isUser(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == resource.data.role
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Institution Memberships:
    // Users cannot add themselves to another institution.
    // Only the institution owner or admin can manage memberships.
    match /institution_members/{membershipId} {
      allow get: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      
      allow create: if isAuthenticated() && (
        // Case A: Owner registering new institution workspace
        (
          request.auth.uid == request.resource.data.user_id &&
          request.resource.data.role == 'owner' &&
          getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institution_id)).data.ownerId == request.auth.uid
        ) ||
        // Case B: Existing institution owner adding a coordinator
        (
          get(/databases/$(database)/documents/institutions/$(request.resource.data.institution_id)).data.ownerId == request.auth.uid &&
          request.resource.data.role == 'coordinator'
        ) ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        // Only owner or admin can update memberships; members cannot escalate their own role
        (
          get(/databases/$(database)/documents/institutions/$(resource.data.institution_id)).data.ownerId == request.auth.uid &&
          request.resource.data.user_id == resource.data.user_id &&
          request.resource.data.institution_id == resource.data.institution_id &&
          request.resource.data.role == 'coordinator'
        ) ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/institutions/$(resource.data.institution_id)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Educational Institutions:
    // Tenant root document with owner verification.
    match /institutions/{institutionId} {
      allow get: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/institution_members/$(institutionId + '_' + request.auth.uid)) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.id == institutionId;
      allow update: if isAuthenticated() && (
        (
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Examinations
      match /examinations/{examId} {
        allow read: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
        allow create: if isAuthenticated() &&
          isInstitutionOwnerOrMember(institutionId) &&
          request.resource.data.institutionId == institutionId;
        allow update: if isAuthenticated() && (
          (
            isInstitutionOwnerOrMember(institutionId) &&
            request.resource.data.institutionId == resource.data.institutionId
          ) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());

        // Students Subcollection
        match /students/{studentId} {
          allow read, write: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
        }

        // Classrooms Subcollection
        match /classrooms/{classroomId} {
          allow read, write: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
        }

        // Seating Plans Subcollection
        match /seating_plans/{planId} {
          allow read, write: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());

          // Room Allocations Subcollection
          match /room_allocations/{allocId} {
            allow read, write: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
          }
        }
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
        allow write: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
      }

      // Audit Logs Subcollection
      match /audit_logs/{logId} {
        allow read: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
        allow create: if isAuthenticated() && (isInstitutionOwnerOrMember(institutionId) || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // Payment Requests Collection:
    // Submitting users can ONLY create with pending status for their own institution.
    // Users CANNOT approve or modify their own payment requests.
    match /payment_requests/{paymentRequestId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount == 499 &&
        request.resource.data.currency == 'INR' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.subscriptionId == null &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.rejectionReason == null &&
        request.resource.data.screenshotStoragePath.matches('payment_proofs/' + request.resource.data.institutionId + '/' + request.auth.uid + '/.*') &&
        isInstitutionOwnerOrMember(request.resource.data.institutionId);

      // Update is STRICTLY ADMIN ONLY. Users CANNOT change status or approve requests.
      allow update: if isAdmin() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.institutionId == resource.data.institutionId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.screenshotStoragePath == resource.data.screenshotStoragePath;

      allow delete: if isAdmin();
    }

    // Subscriptions Collection:
    // Coordinators and owners can read their own institution subscription.
    // Institution owners/members can lock exam type on first exam creation; admin can create, update, or revoke subscriptions.
    match /subscriptions/{subscriptionId} {
      allow get: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.institutionId != null &&
        isInstitutionOwnerOrMember(resource.data.institutionId) &&
        request.resource.data.institutionId == resource.data.institutionId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.expiresAt == resource.data.expiresAt
      );
      allow delete: if isAdmin();
    }

    // Root Notifications Collection:
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    function isValidProofDocId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPaymentProofFile(data) {
      return data.keys().hasAll([
          'paymentRequestId',
          'institutionId',
          'userId',
          'storagePath',
          'fileName',
          'mimeType',
          'sizeBytes',
          'chunkCount',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'paymentRequestId',
          'institutionId',
          'userId',
          'storagePath',
          'fileName',
          'mimeType',
          'sizeBytes',
          'chunkCount',
          'createdAt'
        ]) &&
        isValidProofDocId(data.paymentRequestId) &&
        isValidProofDocId(data.institutionId) &&
        data.userId == request.auth.uid &&
        data.storagePath is string &&
        data.storagePath.size() <= 320 &&
        data.storagePath.matches('payment_proofs/' + data.institutionId + '/' + request.auth.uid + '/.*') &&
        data.fileName is string &&
        data.fileName.size() >= 1 &&
        data.fileName.size() <= 160 &&
        data.mimeType in ['image/jpeg', 'image/png', 'application/pdf'] &&
        data.sizeBytes is int &&
        data.sizeBytes > 0 &&
        data.sizeBytes <= 5242880 &&
        data.chunkCount is int &&
        data.chunkCount >= 1 &&
        data.chunkCount <= 16 &&
        data.createdAt is string &&
        data.createdAt.size() <= 64;
    }

    function isValidPaymentProofChunk(data) {
      return data.keys().hasAll(['chunkIndex', 'dataBase64']) &&
        data.keys().hasOnly(['chunkIndex', 'dataBase64']) &&
        data.chunkIndex is int &&
        data.chunkIndex >= 0 &&
        data.chunkIndex < 16 &&
        data.dataBase64 is string &&
        data.dataBase64.size() > 0 &&
        data.dataBase64.size() <= 750000;
    }

    // Private Payment Proof Files (Zero-Config Firestore Fallback when R2 Worker is unconfigured):
    // Strictly restricted to the uploading institution's owner/members and the verified admin.
    match /payment_proof_files/{paymentRequestId} {
      allow get: if isAuthenticated() && isValidProofDocId(paymentRequestId) && (
        resource.data.userId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.institutionId != null && isInstitutionOwnerOrMember(resource.data.institutionId)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        isValidProofDocId(paymentRequestId) &&
        request.resource.data.paymentRequestId == paymentRequestId &&
        isValidPaymentProofFile(request.resource.data) &&
        isInstitutionOwnerOrMember(request.resource.data.institutionId);
      allow update: if false;
      allow delete: if isValidProofDocId(paymentRequestId) && (
        isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          !exists(/databases/$(database)/documents/payment_requests/$(paymentRequestId))
        )
      );

      match /chunks/{chunkId} {
        allow get: if isAuthenticated() && isValidProofDocId(paymentRequestId) && isValidProofDocId(chunkId) && (
          get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.userId == request.auth.uid ||
          isInstitutionOwnerOrMember(get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.institutionId) ||
          isAdmin()
        );
        allow list: if isAuthenticated() && isValidProofDocId(paymentRequestId) && (
          get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.userId == request.auth.uid ||
          isInstitutionOwnerOrMember(get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.institutionId) ||
          isAdmin()
        );
        allow create: if isAuthenticated() &&
          isValidProofDocId(paymentRequestId) &&
          isValidProofDocId(chunkId) &&
          get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.userId == request.auth.uid &&
          isInstitutionOwnerOrMember(get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.institutionId) &&
          isValidPaymentProofChunk(request.resource.data);
        allow update: if false;
        allow delete: if isValidProofDocId(paymentRequestId) && isValidProofDocId(chunkId) && (
          isAdmin() ||
          (
            isAuthenticated() &&
            get(/databases/$(database)/documents/payment_proof_files/$(paymentRequestId)).data.userId == request.auth.uid &&
            !exists(/databases/$(database)/documents/payment_requests/$(paymentRequestId))
          )
        );
      }
    }
  }
}
